# FixTrail Environment Configuration

# Database Configuration (MySQL)
# Default is configured for local MySQL. If MySQL is not running, FixTrail gracefully falls back to SQLite.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=fixtrail

# Optional direct database connection string
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fixtrail?charset=utf8mb4

# Google Gemini API Key for AI Screenshot Analysis and Troubleshooting
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Security JWT Key
SECRET_KEY=fixtrail-super-secret-jwt-key-2026-production-ready
