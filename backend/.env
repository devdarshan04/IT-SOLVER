# FixTrail Environment Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fixtrail

# Optional direct database connection string
DATABASE_URL=mysql+pymysql://root:@localhost:3306/fixtrail?charset=utf8mb4

# Gemini API Key (Can also be set directly in the Web UI Settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

SECRET_KEY=fixtrail-super-secret-jwt-key-2026-production-ready
